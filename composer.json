{
    "name": "tomatophp/filament-plugins",
    "type": "library",
    "description": "Manage your modules as a plugin system with plugin generator",
    "homepage": "https://tomatophp.com/en/plugins/filament-plugins",
    "keywords": [
        "php",
        "laravel",
        "template",
        "modules",
        "HMVC",
        "filament",
        "plugins",
        "generator"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "TomatoPHP\\FilamentPlugins\\": "src/",
            "TomatoPHP\\FilamentPlugins\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TomatoPHP\\FilamentPlugins\\Tests\\": "tests/src/",
            "TomatoPHP\\FilamentPlugins\\Tests\\Database\\Factories\\": "tests/database/factories",
            "Acme\\": "tests/fixtures/src/Acme/",
            "Modules\\Gamma\\": "tests/fixtures/src/Gamma/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TomatoPHP\\FilamentPlugins\\FilamentPluginsServiceProvider"
            ]
        }
    },
    "scripts": {
        "testbench": "vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse src tests",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "authors": [
        {
            "name": "Fady Mondy",
            "email": "info@3x1.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "calebporzio/sushi": "^2.5.4",
        "filament/filament": "^5.0",
        "nwidart/laravel-modules": "^12.0|^13.0",
        "tomatophp/console-helpers": "^1.1",
        "tomatophp/filament-icons": "^5.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "nunomaduro/collision": "^8.6",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-arch": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0",
        "pestphp/pest-plugin-livewire": "^4.0|^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0|^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "version": "5.0.0"
}
